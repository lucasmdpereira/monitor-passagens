{
  "name": "monitor-passagens",
  "version": "0.2.0",
  "private": true,
  "description": "Consultas nacionais de passagens com entrada e saída JSON",
  "main": "dist/search.js",
  "types": "dist/search.d.ts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "search": "node --import tsx src/cli/search.ts",
    "plan": "node --import tsx src/cli/search.ts --plan",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.5",
    "typescript": "5.9.3"
  }
}
